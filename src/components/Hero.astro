---
import { heroCopy } from "../data/site";
import VerticalTitle from "./VerticalTitle.astro";
import TokenStream from "./TokenStream.astro";

interface Props {
  lang: "en" | "zh";
}

const { lang } = Astro.props;
const copy = heroCopy[lang];
const verticalText = lang === "zh" ? "我建造能落地的AI产品" : "";
---
<section class="hero" data-lang={lang}>
  <div class="hero-gridline" aria-hidden="true"></div>

  {lang === "zh" && (
    <div class="hero-vertical-slot">
      <VerticalTitle text={verticalText} accentChars="AI" />
    </div>
  )}

  <div class="container grid-12 hero-grid">
    <p class="hero-kicker">{copy.kicker}</p>

    <h1 class="hero-headline">
      {copy.headline}
      <span class="accent-square" aria-hidden="true"></span>
    </h1>

    <div class="hero-stream">
      <TokenStream lang={lang} />
    </div>

    <p class="hero-subline">{copy.subline}</p>

    <div class="hero-actions">
      <a href={lang === "en" ? "/en/blog/" : "/zh/blog/"} class="btn primary" data-magnetic>{copy.ctaPrimary}</a>
      <a href={lang === "en" ? "/en/contact/" : "/zh/contact/"} class="btn" data-magnetic>{copy.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero-stream {
    grid-column: 1 / -1;
    margin-top: 16px;
    margin-bottom: 8px;
  }

  @media (max-width: 980px) {
    .hero-stream {
      margin-top: 12px;
    }
  }
</style>
