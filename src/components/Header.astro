---
import { navItems } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: "en" | "zh";
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;
const nav = navItems[lang];

const enPath = pathname.startsWith("/zh/") ? pathname.replace(/^\/zh\//, "/en/") : pathname;
const zhPath = pathname.startsWith("/en/") ? pathname.replace(/^\/en\//, "/zh/") : pathname;
---
<header class="site-header">
  <div class="container inner">
    <a href={lang === "en" ? "/en/" : "/zh/"} class="brand">Zifeng Xiong<span class="dot">.</span></a>

    <button class="mobile-toggle" type="button" data-nav-toggle>
      {lang === "en" ? "Menu" : "菜单"}
    </button>

    <div class="nav-wrap" data-nav-wrap>
      <nav class="nav-links" aria-label="Main navigation">
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="lang-switch" aria-label="Language switcher">
        <a href={enPath} class={lang === "en" ? "active" : ""}>EN</a>
        <span class="divider" aria-hidden="true">/</span>
        <a href={zhPath} class={lang === "zh" ? "active" : ""}>中</a>
      </div>

      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<script>
  const wireMobileToggle = () => {
    const toggle = document.querySelector<HTMLElement>("[data-nav-toggle]");
    const wrap = document.querySelector<HTMLElement>("[data-nav-wrap]");
    if (!toggle || !wrap || toggle.dataset.bound) return;
    toggle.dataset.bound = "1";
    toggle.addEventListener("click", () => {
      wrap.classList.toggle("open");
    });
  };
  wireMobileToggle();
  document.addEventListener("astro:page-load", wireMobileToggle);
</script>
