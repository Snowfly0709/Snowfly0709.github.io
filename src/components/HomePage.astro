---
import Hero from "./Hero.astro";
import SectionNumber from "./SectionNumber.astro";
import DimensionLine from "./DimensionLine.astro";
import SkillMap from "./SkillMap.astro";
import { aboutSections } from "../data/site";
import { tokenizeContent } from "../utils/markup-keywords";

interface Props {
  lang: "en" | "zh";
}

const { lang } = Astro.props;
const about = aboutSections[lang];

// Stable attention-graph node IDs for each work / edu / project entry
// (index-positional — relies on site.ts ordering staying stable)
const workIds = ["work-keyreply", "work-xjtu-rag", "work-xjtu-bd", "work-pmi"];
const eduIds = ["edu-ntu", "edu-xjtu"];
// Order matches `projects` after the period-DESC sort below.
const projectIds = ["proj-sayexact", "proj-mindgap", "proj-dataviz"];

const zhProjectIndex = ["壹", "贰", "叁", "肆", "伍", "陆", "柒", "捌", "玖", "拾"];
const projectIndexFor = (idx: number) =>
  lang === "en" ? String(idx + 1).padStart(2, "0") : zhProjectIndex[idx] ?? String(idx + 1);

const labels = {
  about: lang === "en" ? "About" : "关于",
  experience: lang === "en" ? "Experience" : "工作经历",
  projects: lang === "en" ? "Selected Work" : "代表项目",
  education: lang === "en" ? "Education" : "教育经历",
  publications: lang === "en" ? "Publications" : "出版作品",
  skills: lang === "en" ? "Skill Index" : "技能索引",
  contact: lang === "en" ? "Go To Contact" : "前往联系",
  workAnnotation:
    lang === "en"
      ? `${about.work.length} roles · ${about.education.length} institutions`
      : `${about.work.length} 段经历 · ${about.education.length} 所学校`,
  projectAnnotation:
    lang === "en"
      ? `${about.projects.length} project${about.projects.length === 1 ? "" : "s"} · live & shipping`
      : `${about.projects.length} 个项目 · 已上线`,
  introAnnotation: lang === "en" ? "intro · bio · portrait" : "简介 · 履历 · 肖像",
  skillAnnotation:
    lang === "en" ? "skill index · latent graph" : "技能索引 · 关联图谱",
};

const parsePeriodStart = (period: string) => {
  const monthYear = period.match(/(\d{2})\/(\d{4})/);
  if (monthYear) return Number(monthYear[2]) * 12 + Number(monthYear[1]);
  // zh periods read "2026.08 - 至今"
  const yearMonth = period.match(/(\d{4})\.(\d{1,2})/);
  if (yearMonth) return Number(yearMonth[1]) * 12 + Number(yearMonth[2]);
  const yearOnly = period.match(/(\d{4})/);
  if (yearOnly) return Number(yearOnly[1]) * 12;
  return 0;
};

const projects = [...about.projects].sort(
  (a, b) => parsePeriodStart(b.period) - parsePeriodStart(a.period)
);
---
<Hero lang={lang} />

{/* ===== 01 — About ============================================= */}
<section id="about" class="section spread">
  <div class="container">
    <SectionNumber index={1} lang={lang} label={labels.about} />
    <h2 class="section-title">{labels.about}</h2>
    <DimensionLine annotation={labels.introAnnotation} />

    <div class="grid-12 spread-intro">
      <article class="intro-text" data-reveal="up">
        <p class="about-intro drop-cap" set:html={tokenizeContent(about.intro, lang, "intro")} />
      </article>

      <aside class="intro-portrait" data-reveal="up" data-stagger="1">
        <div class="portrait-frame">
          <img
            src="/images/profile.png"
            alt="Portrait of Zifeng Xiong"
            loading="lazy"
            width="820"
            height="1200"
          />
        </div>
        <p class="portrait-name">Zifeng Xiong</p>
        <p class="portrait-meta">Hong Kong · Singapore</p>
      </aside>
    </div>
  </div>
</section>

{/* ===== 02 — Experience ======================================== */}
<section id="experience" class="section spread">
  <div class="container">
    <SectionNumber index={2} lang={lang} label={labels.experience} />
    <h2 class="section-title">{labels.experience}</h2>
    <DimensionLine annotation={labels.workAnnotation} />

    <div class="grid-12 spread-experience">
      <div class="exp-work" data-reveal="up">
        <h3 class="exp-subhead">{labels.experience}</h3>
        {about.work.map((item, idx) => (
          <article class="exp-item" data-reveal="up" data-stagger={idx + 1}>
            <h4 data-attention-id={workIds[idx]}>{item.title}</h4>
            <p class="meta-line">{item.org} | {item.period}</p>
            <ul class="exp-bullets">
              {item.bullets.map((line, bIdx) => (
                <li
                  class="exp-detail"
                  set:html={tokenizeContent(line, lang, `w${idx}-${bIdx}`)}
                />
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="exp-side">
        <div class="exp-aside-block" data-reveal="up" data-stagger="1">
          <h3 class="exp-subhead">{labels.education}</h3>
          {about.education.map((item, idx) => (
            <article class="exp-item" data-reveal="up" data-stagger={idx + 1}>
              <h4 data-attention-id={eduIds[idx]}>{item.school}</h4>
              <p class="meta-line">{item.degree} | {item.period}</p>
              <p class="exp-detail" set:html={tokenizeContent(item.location, lang, `e${idx}`)} />
            </article>
          ))}
        </div>

        <div class="exp-aside-block" data-reveal="up" data-stagger="2">
          <h3 class="exp-subhead">{labels.publications}</h3>
          {about.publications.map((item, idx) => (
            <article class="exp-item exp-item--narrow" data-reveal="up" data-stagger={idx + 1}>
              <p class="exp-detail" set:html={tokenizeContent(item, lang, `pub${idx}`)} />
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

{/* ===== 03 — Selected Work ===================================== */}
<section id="projects" class="section spread">
  <div class="container">
    <SectionNumber index={3} lang={lang} label={labels.projects} />
    <h2 class="section-title">{labels.projects}</h2>
    <DimensionLine annotation={labels.projectAnnotation} />

    <div class="spread-projects">
      {projects.map((p, idx) => (
        <article class="project-spread" data-reveal="up" data-stagger={idx + 1}>
          <div class="project-spread-head">
            <span class="project-spread-index">{projectIndexFor(idx)}</span>
            <h3 data-attention-id={projectIds[idx]}>{p.name}</h3>
            <p class="meta-line">{p.period}</p>
          </div>
          <p class="project-spread-body" set:html={tokenizeContent(p.detail, lang, `proj${idx}`)} />
          <span class="project-spread-arrow" aria-hidden="true">→</span>
        </article>
      ))}
    </div>
  </div>
</section>

{/* ===== 04 — Skill Index ======================================= */}
<section id="skills" class="section spread">
  <div class="container">
    <SectionNumber index={4} lang={lang} label={labels.skills} />
    <h2 class="section-title">{labels.skills}</h2>
    <DimensionLine annotation={labels.skillAnnotation} />

    <SkillMap lang={lang} />
  </div>
</section>

{/* ===== Contact CTA ============================================ */}
<section class="section section-cta">
  <div class="container">
    <a class="btn primary" href={lang === "en" ? "/en/contact/" : "/zh/contact/"} data-magnetic>
      {labels.contact}
    </a>
  </div>
</section>
