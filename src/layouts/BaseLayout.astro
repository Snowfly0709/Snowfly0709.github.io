---
// Font self-hosting — fontsource bundles woff2 into Astro build
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/source-serif-4/index.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource/noto-serif-sc/400.css";
import "@fontsource/noto-serif-sc/600.css";
import "@fontsource/noto-serif-sc/chinese-simplified-400.css";
import "@fontsource/noto-serif-sc/chinese-simplified-600.css";

import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Colophon from "../components/Colophon.astro";
import ParagraphMark from "../components/ParagraphMark.astro";
import { siteMeta } from "../data/site";

interface Props {
  lang: "en" | "zh";
  title?: string;
  description?: string;
}

const { lang, title = siteMeta.title, description = siteMeta.description } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />

    {/* ElevenLabs Conversational AI widget loader — loaded once, deduped across view transitions */}
    <script is:inline async type="text/javascript" src="https://unpkg.com/@elevenlabs/convai-widget-embed"></script>

    {/* FOUC-free theme bootstrap — runs synchronously on initial load AND after every view transition */}
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var saved = localStorage.getItem("theme");
            var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            var theme = saved || (prefersDark ? "dark" : "light");
            document.documentElement.setAttribute("data-theme", theme);
          } catch (_) {
            document.documentElement.setAttribute("data-theme", "light");
          }
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
  </head>
  <body>
    <ParagraphMark />
    <Header lang={lang} />
    <main>
      <div class="attention-host" data-attention-host>
        <svg
          class="attention-canvas"
          data-attention-canvas
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <g data-attention-edges></g>
        </svg>
        <slot />
      </div>
    </main>

    <Colophon lang={lang} />

    {/* Floating voice-AI widget — persists across client-side navigation so it never flickers */}
    <elevenlabs-convai agent-id="agent_3701ktk6j328fa1bvtkpyje8c96d" transition:persist="convai-widget"></elevenlabs-convai>

    {/* Motion primitives — run on initial load and after each view transition */}
    <script>
      import "../scripts/motion";
      import "../scripts/magnetic";
      import "../scripts/attention-graph";
      import "../scripts/page-tokens";
    </script>

    <script>
      const wireCopyButtons = () => {
        const pres = document.querySelectorAll(".post-body pre");
        for (const pre of pres) {
          if (pre.querySelector(".copy-btn")) continue;
          const button = document.createElement("button");
          button.className = "copy-btn";
          button.textContent = "Copy";
          button.type = "button";
          button.addEventListener("click", async () => {
            const code = pre.querySelector("code");
            if (!code) return;
            try {
              await navigator.clipboard.writeText(code.textContent || "");
              button.textContent = "Copied";
              setTimeout(() => { button.textContent = "Copy"; }, 1200);
            } catch {
              button.textContent = "Failed";
              setTimeout(() => { button.textContent = "Copy"; }, 1200);
            }
          });
          pre.append(button);
        }
      };
      wireCopyButtons();
      document.addEventListener("astro:page-load", wireCopyButtons);
    </script>
  </body>
</html>
